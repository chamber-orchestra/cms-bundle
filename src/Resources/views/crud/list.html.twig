{%- extends '@ChamberOrchestraCms/base.html.twig' -%}
{%- trans_default_domain translation_domain|default('cms') %}
{%- import '@ChamberOrchestraCms/macro/html.html.twig' as html -%}
{# @var title string #}
{# @var label_format string #}
{# @var action #}
{%- block page_title -%}
    {{- (parent_entity_title is defined and parent_entity_title ? parent_entity_title|trans ~ ' • ') ~ (parent_entity_label is defined and parent_entity_label ? parent_entity_label ~ ' • ') ~ title|trans({}, translation_domain)|default (class|humanize) -}}
{%- endblock -%}
{#- a list is a card of the style of the cards of the dashboard (a border, the radius, a margin); no card header on it: the page title is above -#}
{%- block card_class -%}dash-card dash-card-wide cms-list-card{%- endblock -%}
{%- block content_header -%}{%- endblock -%}
{#- The tools of a list (the filter, the columns) are in the bar of the card, under the header of the page, and stay there while the list scrolls. -#}
{%- block content_nav_tools -%}{%- endblock -%}

{%- block content_body_inner -%}
    {%- set has_actions = block('table_actions') is defined
        or (update is defined and update is not null)
        or block('update_button') is defined
        or actions is instanceof('callable') -%}
    {% set has_link = block('table_link') is defined %}
    {%- set has_move = move is defined and move is not null -%}
    {%- set has_entries = entries is defined and entries is not null -%}
    {%- set has_copy = copy is defined and copy is not null and class is instanceof('\\ChamberOrchestra\\CmsBundle\\Contracts\\Entity\\CopyInterface') -%}
    {%- set has_toggle = toggle is defined and toggle is not null and class is instanceof('\\ChamberOrchestra\\DoctrineExtensionsBundle\\Contracts\\Entity\\ToggleInterface') -%}
    {%- set has_delete = delete_form is defined and delete_form -%}
    {%- set any_action = has_actions or has_move or has_entries or has_copy or has_toggle or has_delete -%}

    {#- The bar of the list (as Stripe's; it sticks under the header): the search of the entities (the `search` field of the filter, sent with the whole filter form) and the Filter button (badge = how many are on, "Reset" beside it). -#}
    {%- set has_filter = filter_form is defined and filter_form -%}
    {%- set applied = filters_on|default(0) -%}
    <div class="cms-list-bar">
        {%- if has_filter -%}
            {%- if filter_form.search is defined -%}
                <label class="cms-list-search">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="search" form="cms-filter-form" name="{{ filter_form.search.vars.full_name }}" value="{{ filter_form.search.vars.value }}" placeholder="{{ 'filter.search_placeholder'|trans }}" aria-label="{{ 'filter.search'|trans }}" autocomplete="off">
                </label>
            {%- endif -%}
            <button type="button" class="btn btn-outline {{ applied > 0 ? 'theme-primary' : 'theme-secondary' }} cms-filter-open" data-bs-toggle="dialog" data-bs-target="#modal-filter">
                <i class="fas fa-sliders" aria-hidden="true"></i> {{ 'filter.open'|trans }}
                {%- if applied > 0 %} <span class="badge theme-primary">{{ applied }}</span>{% endif -%}
            </button>
            {%- if applied > 0 -%}
                <a class="cms-filter-reset" href="{{ app.request.pathInfo }}"><i class="fas fa-times" aria-hidden="true"></i> {{ 'filter.reset'|trans }}</a>
            {%- endif -%}
        {%- endif -%}
        <div id="fields_filter_dropdown" class="position-relative" data-controller="fields-filter" data-storage="{{ class|replace({'\\': '_'}) }}">
            <a class="text-decoration-none" role='button' data-bs-toggle="menu" aria-expanded="false" title="{{ 'common.title.fields'|trans }}" aria-label="{{ 'common.title.fields'|trans }}">
                <i class="fas fa-table"></i>
            </a>
            <div class="menu ps-3" data-bs-placement="top-end">
                {%- for field in fields|keys -%}
                    {%- set val = html.field(field, label_format, translation_domain) -%}
                    <div class="menu-text form-check form-check-inline">
                        <input type="checkbox" class="check" value="{{ field }}" id="ff{{ field }}">
                        <label class="form-check-label" for="ff{{ field }}">
                            {{ val }}
                        </label>
                    </div>
                {%- endfor -%}
            </div>
        </div>
    </div>
    <div class="table-responsive mb-0">
        <table class="table table-sm table-list mb-0" data-controller="colsearch table-align">
            <thead>
            <tr>
                {%- if bulk_operation_form is defined and bulk_operation_form -%}
                    <th class="table-shrink text-center" id="bulk-operation-toggler">
                        <div class="form-check form-check-inline">
                            <input type="checkbox" class="check" {#
                            #} data-all-on-page-tooltip="{{ 'crud.index.select_all_on_page'|trans }}" {#
                            #} data-all-tooltip="{{ 'crud.index.select_all'|trans }}" {#
                            #} data-selected-tooltip="{{ 'crud.index.selected'|trans }}" {#
                            #} data-total="{{ pagination.vars.elementsCount|default(0) }}" {#
                            #} data-show-selected-label="{{ 'crud.index.show_selected'|trans }}" {#
                            #} data-show-all-label="{{ 'crud.index.show_all'|trans }}" {#
                            #} name="bulk_operation_toggler" {#
                            #} id="bulk-operation-toggler-input">
                            <label for="bulk-operation-toggler-input" class="form-check-label"></label>
                        </div>
                    </th>
                {%- endif -%}
                {%- if has_link -%}
                    <th class="table-shrink text-center">*</th>
                {%- endif -%}
                {%- block table_headings -%}{%- endblock -%}

                {#- all the actions of a row (edit, move, copy, toggle, delete...) are one cell at the right end -#}
                {%- if any_action -%}
                    <th class="table-shrink table-actions text-center">*</th>
                {%- endif -%}
            </tr>
            </thead>
            <tbody>
            {%- for entity in entities -%}
                {%- set attr = {} -%}
                <tr {{ block('row_attributes') }}>
                    {%- if bulk_operation_form is defined and bulk_operation_form -%}
                        <td class="table-shrink text-center bulk-operation-input">
                            <div class="form-check form-check-inline">
                                <input type="checkbox" class="check" {#
                                #} name="bulk_operation_input" {#
                                #} value="{{ entity.id }}" {#
                                #} id="bi{{ entity.id }}">
                                <label for="bi{{ entity.id }}" class="form-check-label"></label>
                            </div>
                        </td>
                    {%- endif -%}
                    {%- if has_link -%}
                        <td class="table-shrink text-center">
                            {{- block('table_link') -}}
                        </td>
                    {%- endif -%}
                    {%- block table_values -%}{%- endblock -%}
                    {%- if any_action -%}
                        <td class="table-shrink table-actions"><div class="d-flex flex-nowrap justify-content-end gap-1">
                    {%- if has_actions -%}
                            <div class="btn-toolbar lg:flex-nowrap" role="toolbar" {#
                            #}aria-label="{{ 'common.entity_actions'|trans }}">
                                {{- block('table_actions') is defined ? block('table_actions') -}}
                                {%- if update is not null or actions is instanceof('callable') -%}
                                    <div class="btn-group" role="group" aria-label="{{ 'common.edit'|trans }}">
                                        {%- if actions is instanceof('callable') -%}
                                            {{- render_menu(call(actions, entity, parent|default(null)), '@ChamberOrchestraCms/menu/actions.html.twig') -}}
                                        {%- endif -%}
                                        {%- if update is not null -%}
                                            <a href="{{ path(update.route, update.route_params|merge({id: entity.id})) }}"
                                               {#
                                               #}data-bs-toggle="tooltip" {#
                                               #}data-bs-container="body" {#
                                               #}data-bs-boundary="viewport" {#
                                               #}class="btn btn-solid theme-primary" {#
                                               #}title="{{ 'common.edit'|trans }}" {#
                                               #}aria-label="{{ 'common.edit'|trans }}" {#
                                            #}>
                                                <i class="fas fa-fw fa-edit"></i>
                                            </a>
                                        {%- endif -%}
                                    </div>
                                {%- endif -%}
                            </div>
                    {%- endif -%}
                    {%- if (move is defined and move is not null) -%}
                            <div class="btn-toolbar lg:flex-nowrap" role="toolbar" {#
                            #}aria-label="{{ 'common.entity_sort_actions'|trans }}">
                                <div class="btn-group " role="group" aria-label="{{ 'common.move'|trans }}">
                                    <a href="{{ path(move.route, move.route_params|merge({id: entity.id, direction: 'up'})) }}"
                                       {#
                                       #}data-toggle="move" {#
                                       #}data-direction="up" {#
                                       #}class="btn btn-solid theme-warning" {#
                                       #}title="{{ 'common.move_up'|trans }}" {#
                                       #}aria-label="{{ 'common.move_up'|trans }}" {#
                                    #}>
                                        <i class="fas fa-fw fa-angle-up"></i>
                                    </a>
                                    <a href="{{ path(move.route, move.route_params|merge({id: entity.id, direction: 'down'})) }}"
                                       {#
                                       #}data-toggle="move" {#
                                       #}data-direction="down" {#
                                       #}class="btn btn-solid theme-warning" {#
                                       #}title="{{ 'common.move_down'|trans }}" {#
                                       #}aria-label="{{ 'common.move_down'|trans }}" {#
                                    #}>
                                        <i class="fas fa-fw fa-angle-down"></i>
                                    </a>
                                </div>
                            </div>
                    {%- endif -%}
                    {%- if (entries is defined and entries is not null) -%}
                            <a href="{{ path(entries.route, entries.route_params|merge({id: entity.id})) }}"
                               class="btn btn-solid theme-secondary"
                               data-bs-toggle="tooltip"
                               title="{{ 'common.content_entries'|trans }}"
                               aria-label="{{ 'common.content_entries'|trans }}"
                            >
                                <i class="fas fa-fw fa-layer-group"></i>
                            </a>
                    {%- endif -%}
                    {%- if copy is defined and copy is not null and class is instanceof('\\ChamberOrchestra\\CmsBundle\\Contracts\\Entity\\CopyInterface') -%}
                        <a href="{{ path(copy.route, copy.route_params|merge({id: entity.id})) }}"
                           {#
                           #}data-toggle="copy" {#
                           #}class="btn btn-solid theme-warning" {#
                           #}title="{{ 'common.copy'|trans }}" {#
                           #}aria-label="{{ 'common.copy'|trans }}" {#
                        #}>
                            <i class="fas fa-fw fa-copy"></i>
                        </a>
                    {% endif %}
                    {%- if toggle is defined and toggle is not null and class is instanceof('\\ChamberOrchestra\\DoctrineExtensionsBundle\\Contracts\\Entity\\ToggleInterface') -%}
                            <a href="{{ path(toggle.route, toggle.route_params|merge({id: entity.id})) }}"
                               class="btn {{ entity.enabled ? 'btn-solid theme-info' : 'btn-outline theme-info' }}"
                               data-bs-toggle="tooltip"
                               title="{{ entity.enabled ? 'common.toggle_off'|trans : 'common.toggle_on'|trans }}"
                               aria-label="{{ entity.enabled ? 'common.toggle_off'|trans : 'common.toggle_on'|trans }}"
                            >
                                {%- if entity.enabled -%}
                                    <i class="fas fa-fw fa-eye-slash"></i>
                                {%- else -%}
                                    <i class="fas fa-fw fa-eye"></i>
                                {%- endif -%}
                            </a>
                    {%- endif -%}

                    {%- if delete_form is defined and delete_form -%}
                            <button type="button" class="btn btn-solid theme-danger" {#
                            #}title="{{ 'common.delete'|trans }}" {#
                                    #}aria-label="{{ 'common.delete'|trans }}" {#
                                    #}data-bs-toggle="dialog" {#
                                    #}data-bs-target="#modal-delete" {#
                                    #}data-form="#delete" {#
                                    #}data-values="{{ {"entity": entity.id}|json_encode }}">
                                <i class="fas fa-fw fa-times"></i>
                            </button>
                    {%- endif -%}
                        </div></td>
                    {%- endif -%}
                </tr>
            {%- else -%}
                <tr>
                    <td colspan="100">
                        <div class="alert theme-warning text-center mb-0">
                            <p class="mb-0">{{- "common.text.no_entities"|trans -}}</p>
                        </div>
                    </td>
                </tr>
            {%- endfor -%}
            </tbody>
        </table>
    </div>

{%- endblock -%}

{#- The pagination with the size of the page: above the table and under it. -#}
{%- block pager -%}
    {%- if pagination is defined and pagination is not null -%}
        {{- render_pagination(pagination, "@ChamberOrchestraCms/pagination/base.html.twig") -}}
        {%- if pagination.vars.elementsCount is defined -%}
            <span class="cms-list-total">{{ 'common.total'|trans({'{count}': pagination.vars.elementsCount|number_format(0, ',', ' ')}) }}</span>
        {%- endif -%}
        {#- How many rows a page shows: the links keep the filter and the order of the address and start from the first page. -#}
        {%- set current = app.request.query.getInt('limit') -%}
        {%- set query = app.request.query.all|filter((value, key) => key not in ['page', 'limit']) -%}
        <nav class="cms-page-size" aria-label="{{ 'common.per_page'|trans }}">
            <span>{{ 'common.per_page'|trans }}</span>
            {%- for size in [32, 64, 128] -%}
                <a href="{{ app.request.pathInfo ~ '?' ~ (query|merge({limit: size})|url_encode) }}"{% if size == (current in [32, 64, 128] ? current : 32) %} class="active" aria-current="true"{% endif %}>{{ size }}</a>
            {%- endfor -%}
        </nav>
    {%- endif -%}
{%- endblock -%}

{%- block content_footer -%}
    {% set has_parent_link = block('parent_link') is defined %}
    {%- if pagination is defined or has_parent_link -%}
        <div class="card-footer">
            {{- block('pager') -}}
        </div>
    {%- endif -%}
{%- endblock -%}

{%- block body -%}
    {{- parent() -}}
    {%- if bulk_operation_form is defined and bulk_operation_form is not null -%}
        {%- form_theme bulk_operation_form with ['form_div_layout.html.twig'] only -%}
        {{- form_start(bulk_operation_form, {attr: {id: 'bulk-operation-form', 'data-manual': 'true'}}) -}}
        {%- for e in bulk_operation_form -%}
            {{- form_widget(e) -}}
        {%- endfor -%}
        {{- form_end(bulk_operation_form) -}}
    {%- endif -%}
{%- endblock -%}


{%- block modals -%}
    {%- if filter_form is defined and filter_form -%}
        {%- include '@ChamberOrchestraCms/crud/filter.modal.html.twig' with {form: filter_form} only -%}
    {%- endif -%}
    {%- if delete_form is defined and delete_form -%}
        {%- include '@ChamberOrchestraCms/crud/delete.modal.html.twig' with {form: delete_form} only -%}
    {%- endif -%}
    {%- if bulk_operation_form is defined and bulk_operation_form -%}
        {%- include '@ChamberOrchestraCms/crud/bulk.modals.html.twig' with {bulk_delete: bulk_delete|default(null), bulk_update: bulk_update|default(null), bulk_update_form: bulk_update_form|default(null), translation_domain: translation_domain|default('cms')} only -%}
    {%- endif -%}
{%- endblock -%}





{%- block row_attributes -%}
    {%- set attr = attr|default({})|merge({id: entity.id}) -%}
    {%- if (move is defined and move is not null) and entity.sortOrder is defined -%}
        {%- set attr = attr|merge({"data-sort-order": entity.sortOrder}) -%}
    {%- endif -%}
    {{ block('attributes') }}
{%- endblock row_attributes -%}

{% block attributes -%}
    {%- for attrname, attrvalue in attr -%}
        {{- " " -}}
        {%- if attrname in ['placeholder', 'title'] -%}
            {{- attrname }}="{{ translation_domain is same as(false) ? attrvalue : attrvalue|trans(attr_translation_parameters, translation_domain) }}"
        {%- elseif attrvalue is same as(true) -%}
            {{- attrname }}="{{ attrname }}"
        {%- elseif attrvalue is not same as(false) -%}
            {{- attrname }}="{{ attrvalue }}"
        {%- endif -%}
    {%- endfor -%}
{%- endblock attributes -%}