{%- trans_default_domain 'cms' -%}
{%- apply spaceless -%}
    <!doctype html>
    <html lang="{{ app.request.locale }}" class="h-100" data-copy-label="{{ 'common.copy'|trans }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <title>{%- block meta_title %}{{ block('page_title')|striptags|trim }}{% endblock %}</title>
        <meta name="turbo-cache-control" content="no-cache">
        {%- block stylesheets %}{{ vite_entry_link_tags('cms', {attr: {'data-turbo-track': 'reload'}}) }}{%- endblock %}
    </head>
    <body class="min-vh-100">
    {%- block body %}
        {#- The menu: docked on a wide screen, open or closed as the cookie `aside-closed` says (the server renders it); an overlay on a phone, closed until the burger is pressed. -#}
        <div class="cms-shell {{ app.request.cookies.get('aside-closed', '0') == '1' ? 'aside-closed' }}" data-controller="aside">
            <aside id="cms-menu" class="cms-aside" aria-label="{{ 'common.menu'|trans }}">
                <div class="cms-aside-header">
                    {#- The burger of a wide screen: it opens and closes the menu (a rail of icons). On a phone the one in the top bar opens the overlay and the cross closes it. -#}
                    <button type="button" class="cms-aside-burger" data-action="aside#toggle" aria-controls="cms-menu" aria-label="{{ 'common.menu'|trans }}">
                        <i class="fas fa-bars"></i>
                    </button>
                    <span class="cms-aside-user" title="{{ app.user.systemName }}"><i class="fas fa-user-circle" aria-hidden="true"></i><strong class="text-truncate">{{- app.user.systemName -}}</strong></span>
                    <button type="button" class="btn-close cms-aside-close" data-action="aside#close" aria-label="{{ 'common.close'|trans }}"></button>
                </div>
                <div class="cms-aside-body">
                    {%- block aside_inner %}
                        {#- The navigation the application configured (`chamber_orchestra_cms.sidebar_menu`): the bundle names no class of the application. -#}
                        {%- if cms.sidebar_menu -%}{{- render_menu(cms.sidebar_menu, "@ChamberOrchestraCms/menu/sidebar.html.twig") -}}{%- endif -%}
                    {%- endblock %}
                </div>
                <div class="cms-aside-footer">
                    <a href="{{ logout_path() }}" class="btn btn-sm btn-outline theme-secondary w-100"><i class="fas fa-sign-out me-1"></i>{{- 'app.signout'|trans -}}</a>
                </div>
            </aside>
            <div class="cms-backdrop" data-action="click->aside#close"></div>

            <div class="cms-content">
                <div class="cms-bar">
                    <button type="button" class="btn btn-text theme-secondary cms-burger" data-action="aside#toggle" aria-controls="cms-menu" aria-label="{{ 'common.menu'|trans }}">
                        <i class="fas fa-bars"></i>
                    </button>
                    {%- block bar_search -%}{%- if cms.search_route -%}{{- include('@ChamberOrchestraCms/search_box.html.twig', {q: q|default('')}) -}}{%- endif -%}{%- endblock -%}
                </div>
        <main class="cms-main" id="main" data-controller="bulk sort values">
                {#- The head of the page (as Stripe's): the title with the actions of the page opposite it (create, export), the trail over the title. -#}
                <div class="cms-pagehead">
                    <div class="cms-pagehead-title">
                        {%- if breadcrumbs is defined and (nav is not defined or nav is empty) -%}
                            {%- include '@ChamberOrchestraCms/breadcrumbs/base.html.twig' with {breadcrumbs: breadcrumbs} only -%}
                        {%- endif -%}
                        <h1 class="cms-bar-title" id="page-title">
                            {%- block page_title -%}
                                {{- page_title|default('') -}}
                            {%- endblock -%}
                        </h1>
                    </div>
                    <div class="cms-pagehead-actions">
                        {%- block page_actions -%}
                            {%- if nav is defined and nav is not empty -%}{{- render_menu(nav, '@ChamberOrchestraCms/menu/nav_head.html.twig') -}}{%- endif -%}
                        {%- endblock -%}
                    </div>
                </div>
                {#- Under the bar: the row of the section's menu. The title of the page and the trail are in the bar. -#}
                <header class="cms-title">
                    {#- One row under the title: the section's menu (List / Create / Edit...; hidden when it has a single item), the tools of the page (the column picker of a list) at its end, and the bulk bar that covers them while rows are selected. No row when it is empty. -#}
                    <div class="cms-subbar">
                        {%- block content_tabs -%}
                            {%- if nav is defined and nav is not empty -%}
                                <nav class="cms-tabs" aria-label="{{ 'common.menu'|trans }}">{{- render_menu(nav, '@ChamberOrchestraCms/menu/nav.html.twig') -}}</nav>
                            {%- endif -%}
                        {%- endblock -%}
                        {%- block content_nav_tools %}{%- endblock -%}
                    </div>
                </header>

                {%- block main %}
                    <section class="content-section">
                        {%- block content %}
                            <div class="card card-content {% block card_class %}{% endblock %}">
                                {%- block content_header -%}{%- endblock -%}
                                {%- block content_body %}
                                    <article class="card-body">{%- block content_body_inner %}{%- endblock %}</article>
                                {%- endblock %}
                                {%- block content_footer %}
                                    <footer class="card-footer">{%- block content_footer_inner %}{%- endblock %}</footer>
                                {%- endblock %}

                            </div>
                            <div class="content-wrapper {{- aside_open|default(false) ? "aside-open" : "" -}}">
                                <div class="content-inner">
                                    <nav class="content-nav"></nav>
                                    <article class="content-body"></article>
                                    <footer class="content-footer"></footer>
                                </div>
                                {%- block content_aside -%}
                                {%- endblock -%}
                            </div>
                        {%- endblock %}
                    </section>
                {%- endblock %}
        </main>
                {#- The bar of the selected rows of a list: a dark plate at the bottom of the window (fixed), over the bar of the pages; it is there while rows are selected. -#}
                {%- if (bulk_nav is defined and bulk_nav is not empty) -%}
                    <div id="bulk-nav" class="nav nav-card" role="toolbar" aria-label="{{ 'crud.index.selected'|trans|striptags|replace({'{count}': ''})|trim }}">
                        {{- render_menu(bulk_nav, '@ChamberOrchestraCms/menu/nav.html.twig') -}}
                    </div>
                {%- endif -%}
            </div>
        </div>
    {%- endblock %}
    {%- block javascripts %}{{ vite_entry_script_tags('cms', {attr: {'data-turbo-track': 'reload'}}) }}{%- endblock %}
    {%- block modals %}{%- endblock %}
    {%- block toasts -%}
        <div class="toaster-container" data-controller="toaster">
            {%- set prototype -%}
                {%- apply spaceless -%}
                    <div class="toast" role="status" data-bs-delay="5000">
                        <div class="toast-header position-relative">
                            <i class="fas fa-check-circle fa-fw me-2 fg-success"></i>
                            <strong class="me-auto">{{- 'toast.success'|trans -}}</strong>
                            <button type="button" class="btn-close ms-2 mb-1" {#
                            #}data-bs-dismiss="toast" {#
                                    #}aria-label="{{ 'common.close'|trans }}">
                                <i class="fas fa-times fa-fw"></i>
                            </button>
                        </div>
                        <div class="toast-body">__body__</div>
                    </div>
                {%- endapply -%}
            {%- endset -%}
            <div id="toaster-success" aria-live="polite" aria-atomic="true" data-prototype="{{ prototype|e }}">
                {%- for flash in app.flashes('success') -%}
                    {{- prototype|replace({'__body__': flash|trans})|raw -}}
                {%- endfor -%}
            </div>
            {%- set prototype -%}
                {%- apply spaceless -%}
                    <div class="toast bg-danger fg-white" role="alert" data-bs-delay="5000">
                        <div class="toast-header position-relative">
                            <i class="fas fa-ban fa-fw me-2"></i>
                            <strong class="me-auto">{{- 'toast.error'|trans -}}</strong>
                            <button type="button" class="btn-close ms-2 mb-1" data-bs-dismiss="toast"
                                    aria-label="{{ 'common.close'|trans }}">
                                <i class="fas fa-times fa-fw"></i>
                            </button>
                        </div>
                        <div class="toast-body">__body__</div>
                    </div>
                {%- endapply -%}
            {%- endset -%}
            <div id="toaster-error" aria-live="assertive" aria-atomic="true" data-prototype="{{ prototype|e }}">
                {%- for flash in app.flashes('danger') -%}
                    {{- prototype|replace({'__body__': flash|trans})|raw -}}
                {%- endfor -%}
            </div>
        </div>
    {%- endblock -%}
    </body>
    </html>
{%- endapply -%}