{#- A dialog (Bootstrap 6: the native <dialog> element). Blocks: title, body, footer_outer. Variables: attr (id, class), dialog_attr (class: dialog-sm, dialog-lg). -#}
{%- import '@ChamberOrchestraCms/macro/html.html.twig' as html -%}
{%- trans_default_domain 'cms' -%}
{%- set attr = attr|default({})|merge({
    class: ('dialog ' ~ dialog_attr.class|default('') ~ ' ' ~ attr.class|default(''))|trim,
}) -%}

{%- block modal -%}
    <dialog {{ html.attributes(attr) }}>
        {%- block content -%}
            {%- block header_outer -%}
                <div class="dialog-header">
                    <h5 class="dialog-title">
                        {%- block title -%}{%- endblock -%}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="{{ 'modal.close'|trans }}"></button>
                </div>
            {%- endblock -%}

            {%- block body_outer -%}
                <div class="dialog-body">
                    {%- block body -%}{%- endblock -%}
                </div>
            {%- endblock -%}

            {%- block footer_outer -%}
            {%- endblock -%}
        {%- endblock -%}
    </dialog>
{%- endblock -%}
